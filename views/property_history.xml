<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="property_history_action"
        model="ir.actions.act_window"
    >
        <field name="name">History</field>
        <field name="res_model">property.history</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="property_history_menu"
        name="Histories"
        parent="properties_menu"
        action="property_history_action"
        sequence="10"
    />
    <record id="property_history_view_list" model="ir.ui.view">
        <field name="name">property.history.view.list</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="property_id" />
                <field name="old_state" />
                <field name="new_state" />
                <field name="user_id" />
            </list>
        </field>
    </record>

    <record id="property_history_view_form" model="ir.ui.view">
        <field name="name">property history view form</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"    >
                <group string="User History info">
                    <group>
                        <field name="old_state" />
                        <field name="new_state" />
                        <field name="reason" />
                    </group>
                    <group>
                        <field name="user_id" />
                        <field name="property_id" />
                    </group>
                </group>
            </form>
        </field>
    </record>


</odoo>